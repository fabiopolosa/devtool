{
  "name": "ai-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "AI development control-plane monorepo",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "db:migrate": "pnpm --filter @cp/db db:migrate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "brainstorm:migrate:legacy": "node scripts/migrations/migrate-brainstorm-plan-legacy.mjs",
    "verify:smoke": "pnpm --filter @cp/web test -- --run src/__tests__/dashboard.smoke.test.tsx",
    "verify:visual": "node scripts/verifier/visual-regression.mjs",
    "verify:performance": "node scripts/verifier/performance-benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.22.0",
    "playwright": "^1.55.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}
