{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@cp/domain": ["packages/domain/src/index.ts"],
      "@cp/providers": ["packages/providers/src/index.ts"],
      "@cp/memory": ["packages/memory/src/index.ts"],
      "@cp/retrieval": ["packages/retrieval/src/index.ts"],
      "@cp/verifier": ["packages/verifier/src/index.ts"],
      "@cp/orchestration-ruflo": ["packages/orchestration-ruflo/src/index.ts"],
      "@cp/autoresearch": ["packages/autoresearch/src/index.ts"],
      "@cp/config": ["packages/config/src/index.ts"],
      "@cp/agents": ["packages/agents/src/index.ts"],
      "@cp/db": ["packages/db/src/index.ts"],
      "@cp/ui-kit": ["packages/ui-kit/src/index.ts"],
      "@cp/auth": ["packages/auth/src/index.ts"],
      "@cp/skills": ["packages/skills/src/index.ts"],
      "@cp/secrets": ["packages/secrets/src/index.ts"],
      "@cp/schema-docs": ["packages/schema-docs/src/index.ts"],
      "@cp/environments": ["packages/environments/src/index.ts"],
      "@cp/local-repos": ["packages/local-repos/src/index.ts"],
      "@cp/versioning": ["packages/versioning/src/index.ts"],
      "@cp/subprompts": ["packages/subprompts/src/index.ts"],
      "@cp/brainstorming": ["packages/brainstorming/src/index.ts"],
      "@cp/mcp": ["packages/mcp/src/index.ts"],
      "@cp/prompt-builder": ["packages/prompt-builder/src/index.ts"],
      "@cp/runner": ["packages/runner/src/index.ts"],
      "@cp/knowledge": ["packages/knowledge/src/index.ts"],
      "@cp/context": ["packages/context/src/index.ts"],
      "@cp/worker-local": ["packages/worker-local/index.ts"]
    }
  }
}
