# Core
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_STORE_MODE=postgres
WEB_ORIGIN=http://localhost:5173
AUTH_ENABLED=0
AUTH_SESSION_TTL_HOURS=24
AUTH_SESSION_REFRESH_TTL_HOURS=336
AUTH_OIDC_ENABLED=0
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET_REF=
# Suggested for dashboard flow: http://localhost:5173/login
AUTH_OIDC_REDIRECT_URI=
AUTH_OIDC_SCOPES=openid,profile,email
AUTH_OIDC_AUTHORIZATION_ENDPOINT=
AUTH_OIDC_TOKEN_ENDPOINT=
AUTH_OIDC_USERINFO_ENDPOINT=

# Web
VITE_API_BASE_URL=http://localhost:4000
VITE_AUTH_ENABLED=0
VITE_AUTH_OIDC_ENABLED=0

# Database
DATABASE_URL=postgres://controlplane:controlplane@127.0.0.1:56432/controlplane

# Queue
REDIS_URL=redis://localhost:6379

# Storage
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_LOCAL_ROOT=./artifacts/runtime

# Encryption
SECRETS_MASTER_KEY=change_me_32_chars_minimum

# Provider keys (examples)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
KIE_AI_API_KEY=

# Provider test toggles
PROVIDER_E2E=0
PROVIDER_E2E_DEEP=0
PROVIDER_E2E_MODE=off

# Optional verifier hooks
VERIFIER_TARGET_URL=
PERF_MAX_DCL_MS=5000
PERF_MAX_LOAD_MS=8000
